# ===========================================
# CONFIGURAÇÃO DO SUPABASE
# ===========================================

# URL do projeto Supabase (obtenha em: Supabase Dashboard > Settings > API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co

# Chave anônima pública (obtenha em: Supabase Dashboard > Settings > API > Project API keys)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Chave de serviço (obtenha em: Supabase Dashboard > Settings > API > Project API keys > service_role)
# ATENÇÃO: Esta chave tem acesso total ao banco. Use apenas no backend!
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ===========================================
# BANCO DE DADOS LOCAL (Desenvolvimento)
# ===========================================

# PostgreSQL local (se não usar Supabase)
DATABASE_URL="postgresql://user:password@localhost:5432/incidents_db"

# ===========================================
# MODO DE BANCO DE DADOS
# ===========================================

# Defina como 'true' para usar Supabase, 'false' para usar JSON (padrão)
USE_SUPABASE=false

# ===========================================
# AUTENTICAÇÃO (NextAuth)
# ===========================================

NEXTAUTH_SECRET=sua-chave-secreta-aqui-gerada-com-openssl
NEXTAUTH_URL=http://localhost:3000

# Para produção com Supabase Auth, adicione:
# NEXTAUTH_URL=https://seu-dominio.com

# ===========================================
# CONFIGURAÇÕES ADICIONAIS
# ===========================================

# Tempo de atualização do mapa (em ms)
NEXT_PUBLIC_MAP_REFRESH_INTERVAL=5000

# Intervalo de backup automático (em ms) - padrão: 5 minutos
BACKUP_INTERVAL=300000

