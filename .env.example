# ============================================
# Configuração do Banco de Dados
# ============================================

# Define qual banco usar:
# - "true" = Supabase (produção)
# - "false" ou indefinido = JSON local (desenvolvimento)
USE_SUPABASE=false

# ============================================
# Configurações do Supabase
# ============================================

# URL do projeto (obtenha em: https://app.supabase.com/project/_/settings/api)
NEXT_PUBLIC_SUPABASE_URL=https://xxxxx.supabase.co

# Chave anônima - usada no frontend (obtenha em: Project Settings > API)
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Chave de serviço - usada no backend para operações admin (NÃO exponha no frontend!)
# Obtain in: Project Settings > API > service_role
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

